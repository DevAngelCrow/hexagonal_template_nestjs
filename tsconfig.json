{
  "compilerOptions": {
    "module": "commonjs",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node", "multer", "passport", "passport-jwt", "bcrypt"],
    "paths": {
      "@/*": ["./src/*"],
      "src/*": ["./src/*"],
      "generated/*": ["./generated/*"],
      "@/modules/iam/*": ["./src/modules/iam/*"],
      "@/modules/auth/*": ["./src/modules/iam/auth/*"],
      "@/modules/identity-access-management/*": ["./src/modules/iam/identity-access-management/*"],
      "@/modules/profile/*": ["./src/modules/iam/profile/*"],
      "@/modules/security/*": ["./src/modules/iam/security/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "prisma",
    "prisma7.config.ts",
    "vitest.config.ts",
    "vitest.config.e2e.ts",
    "**/*spec.ts"
  ]
}
