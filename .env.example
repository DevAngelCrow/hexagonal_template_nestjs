API_URL=http://localhost:3000/api/v1
APP_URL=http://localhost:3000
APP_NAME=TemplateNestApp

DB_HOST=localhost
#DB_HOST=host.docker.internal
DB_USER=user
DB_PASSWORD=password
DB_NAME=databasename
DB_PORT=5432
DB_PROVIDER=postgresql
PORT=3000
DATABASE_URL="postgresql://user:p4$$w0rd@localhost:5432/nest_db_template?schema=public"

# Optional container port offsets for local docker-compose isolation
DOCKER_DB_PORT=5432
DOCKER_REDIS_PORT=6379

NODE_ENV=development
SHOW_STACK_TRACE=true

# Storage configuration (LOCAL or S3)
PROVIDER_STORAGE_CODE="LOCAL"

# S3-compatible storage (Cloudflare R2, AWS S3, MinIO)
# Required only if PROVIDER_STORAGE_CODE=S3:
# S3_REGION=auto
# S3_BUCKET=my-bucket
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev
# S3_KEY_PREFIX=

JWT_SECRET=secret
JWT_EXPIRES_IN=1d

JWT_REFRESH_SECRET=secret_refresh
JWT_REFRESH_EXPIRES_IN=7d

EMAIL_HOST=gmail
EMAIL_FROM=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SECRET=
EMAIL_API_KEY=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://:password@localhost:6379
REDIS_PASSWORD=

CLIENT_URL=http://localhost:5174
CLIENT_VERIFY_EMAIL_ROUTE=/verify-email
CLIENT_FORGOTTEN_PASSWORD=/reset-forgotten-password


THROTTLE_GLOBAL_TTL=6000
THROTTLE_GLOBAL_LIMIT=100
THROTTLE_LOGIN_TTL=6000
THROTTLE_LOGIN_LIMIT=5

ENABLE_API_DOCS=true
# Optional: comma-separated list of additional allowed CORS origins
# CORS_ORIGINS=https://app.domain.com,https://admin.domain.com